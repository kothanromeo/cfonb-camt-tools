---
interface Props {
  label?: string;
  /** Exemple proposé par défaut : CFONB ou camt.053. */
  sample?: 'cfonb' | 'camt' | 'mt940';
}
const { label = 'Déposez votre relevé bancaire (CFONB 120, MT940 ou camt.053)', sample = 'cfonb' } = Astro.props;
---
<section class="converter" data-converter data-sample-kind={sample} aria-label="Convertisseur de relevés bancaires">
  <div class="drop" data-drop>
    <p class="big">{label}</p>
    <p>Fichiers .txt, .dat, .cfonb, .120, .sta, .940, .xml… Glissez-déposez le fichier ici, ou</p>
    <div class="btn-row" style="justify-content:center">
      <label class="btn" style="margin:0;color:var(--accent-ink)">
        Choisir un fichier
        <input type="file" data-file />
      </label>
      <button type="button" class="btn secondary" data-sample>Essayer avec un exemple</button>
    </div>
    <p class="privacy">🔒 Conversion 100 % locale : votre relevé ne quitte pas votre ordinateur.</p>
  </div>
  <div class="result" data-result hidden aria-live="polite"></div>
</section>

<script>
  import { mountConverter } from '../scripts/converter';
  document.querySelectorAll<HTMLElement>('[data-converter]').forEach(mountConverter);
</script>
